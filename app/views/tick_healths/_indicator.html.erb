<% if stage = tick_health_for(column) %>
  <%= tag.div class: "tick-health", data: {
        controller: "tick-health", tick_health_board_value: column.board_id,
        tick_health_stage_value: stage["stage_id"],
        tick_health_snapshot_value: stage, tick_health_url_value: board_tick_health_path(column.board),
        action: "mouseenter->tick-health#show mouseleave->tick-health#hideUnlessPinned focusin->tick-health#show focusout->tick-health#hideUnlessPinned keydown->tick-health#keyboard online@window->tick-health#recover"
      } do %>
    <button type="button" class="tick-health__button btn btn--plain" data-tick-health-target="button"
      data-action="click->tick-health#toggle" aria-expanded="false" aria-controls="tick_detail_<%= column.id %>">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2.5 1.5"/></svg>
      <span data-tick-health-target="label"><%= tick_health_label(stage) %></span>
    </button>
    <div id="tick_detail_<%= column.id %>" class="tick-health__detail" popover="auto" data-tick-health-target="detail" data-action="toggle->tick-health#toggled">
      <strong><%= stage["description"] %></strong>
      <dl data-tick-health-target="fields"></dl>
      <p>La próxima corrida no es una estimación de entrega.</p>
    </div>
  <% end %>
<% end %>
