<%# Handy: after approving a card from the dock, offer the next one waiting. %>
<% next_card = column.next_card_awaiting %>
<div class="approval-toast" role="status" data-controller="element-removal" style="--card-color: <%= column.color %>;">
  <div class="approval-toast__inner shadow">
    <% if next_card %>
      <span class="approval-toast__text">
        <strong>Approved!</strong> Next in <%= column.name %>:
        <span class="approval-toast__title overflow-ellipsis"><%= next_card.title %></span>
      </span>
      <%= link_to card_path(next_card), class: "approval-toast__next btn", data: { turbo_frame: "_top" } do %>
        <span>Continue</span>
        <%= icon_tag "arrow-right" %>
      <% end %>
    <% else %>
      <span class="approval-toast__text"><strong>All caught up!</strong> No more cards in <%= column.name %> 🎉</span>
    <% end %>
    <button type="button" class="approval-toast__close btn btn--circle borderless" data-action="element-removal#remove">
      <%= icon_tag "close" %>
      <span class="for-screen-reader">Dismiss</span>
    </button>
  </div>
</div>
