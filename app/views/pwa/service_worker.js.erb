const ASSET_CACHE = "fizzy-assets-v3"
let activeSession = null
let generation = 0
let cacheOperations = Promise.resolve()

// Serialize writes and deletion. A late response must not recreate a cache
// that logout has already removed.
function withCaches(operation) {
  const result = cacheOperations.then(operation)
  cacheOperations = result.catch(() => {})
  return result
}

function clearPrivateCaches() {
  generation++
  activeSession = null
  return withCaches(async () => {
    const names = await caches.keys()
    await Promise.all(names.filter(name => name !== ASSET_CACHE).map(name => caches.delete(name)))
    await clearLegacyRegistry()
  })
}

async function clearLegacyRegistry() {
  const name = "turbo-offline-database"
  if (indexedDB.databases && !(await indexedDB.databases()).some(database => database.name === name)) return

  // Deleting the database blocks while an old tab/worker has an open
  // connection. A transaction clears the URLs without waiting for it to close.
  await new Promise((resolve, reject) => {
    const opening = indexedDB.open(name)
    opening.onerror = () => reject(opening.error)
    opening.onsuccess = () => {
      const database = opening.result
      if (database.objectStoreNames.contains("cache-registry")) {
        const transaction = database.transaction("cache-registry", "readwrite")
        transaction.objectStore("cache-registry").clear()
        transaction.oncomplete = () => { database.close(); resolve() }
        transaction.onabort = transaction.onerror = () => { database.close(); reject(transaction.error) }
      } else {
        database.close()
        resolve()
      }
    }
  })
}

self.addEventListener("install", event => event.waitUntil(self.skipWaiting()))
self.addEventListener("activate", event => {
  event.waitUntil(clearPrivateCaches().then(() => self.clients.claim()))
})

self.addEventListener("fetch", event => {
  const url = new URL(event.request.url)
  if (url.origin === self.location.origin) {
    event.respondWith(handleRequest(event, url))
  }
})

async function handleRequest(event, url) {
  const request = event.request
  if (isAsset(request, url)) return fetchAsset(request)

  // Covers HTML logout, JSON logout, passkey form.submit(), transfer, magic
  // links and email/identity changes without depending on a DOM submit event.
  if (changesSession(request, url)) await clearPrivateCaches()
  const requestGeneration = generation

  // Private requests keep the server's HTTP policy. They are never written
  // to Cache Storage and cannot fall back to a previous authenticated page.
  const response = await fetch(request)

  if (requestGeneration !== generation) return response

  const session = response.headers.get("X-Fizzy-Offline-Session")
  if (response.headers.get("X-Fizzy-Clear-Offline-Cache") === "true" ||
      (session && session !== activeSession) ||
      /\bno-store\b/i.test(response.headers.get("Cache-Control") || "")) {
    const clearedGeneration = generation + 1
    await clearPrivateCaches()
    if (generation !== clearedGeneration) return response
    activeSession = session === "none" ? null : session
  }
  return response
}

function changesSession(request, url) {
  if (["GET", "HEAD"].includes(request.method)) return false
  const path = url.pathname.replace(/^\/\d+(?=\/)/, "")
  return /^\/session(?:[/.]|$)/.test(path) || /^\/join\//.test(path) ||
    /^\/users\/[^/]+\/email_addresses\//.test(path)
}

function isAsset(request, url) {
  return request.method === "GET" && !url.search &&
    !request.headers.has("Authorization") && !request.headers.has("X-CSRF-Token") &&
    /^\/assets\/.+[-.][0-9a-f]+\.(js|css|svg|png|jpg|webp|woff2?|ico)$/.test(url.pathname)
}

function canStore(response, contentType) {
  return response.status === 200 && response.type !== "opaque" &&
    !/\bno-store\b/i.test(response.headers.get("Cache-Control") || "") &&
    (!contentType || response.headers.get("Content-Type")?.includes(contentType))
}

async function fetchAsset(request) {
  const cache = await caches.open(ASSET_CACHE)
  const cached = await cache.match(request.url)
  if (cached) return cached
  const response = await fetch(request, { credentials: "omit" })
  if (canStore(response) && !response.redirected && !response.headers.get("Content-Type")?.includes("text/html")) {
    const body = await response.clone().arrayBuffer()
    if (body.byteLength <= 1024 * 1024) {
      await cache.put(request.url, response.clone())
      const keys = await cache.keys()
      await Promise.all(keys.slice(0, Math.max(0, keys.length - 500)).map(key => cache.delete(key)))
    }
  }
  return response
}

self.addEventListener("push", (event) => {
  const data = event.data.json()
  event.waitUntil(Promise.all([ showNotification(data), updateBadgeCount(data.options) ]))
})

async function showNotification({ title, options }) {
  return self.registration.showNotification(title, options)
}

async function updateBadgeCount({ data: { badge } }) {
  return self.navigator.setAppBadge?.(badge || 0)
}

self.addEventListener("notificationclick", (event) => {
  event.notification.close()

  const url = new URL(event.notification.data.url, self.location.origin).href
  event.waitUntil(openURL(url))
})

async function openURL(url) {
  const clients = await self.clients.matchAll({ type: "window" })
  const focused = clients.find((client) => client.focused)

  if (focused) {
    await focused.navigate(url)
  } else {
    await self.clients.openWindow(url)
  }
}
